<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd'>
  <!-- 曲選択の画面の上に浮かぶ一枚の板（74 x 22.4、並びの一覧を出すときは 120 x 60.2）。板の背景は出さず、マスを詰めて板の形を作る。
       旧い板の「一枚もので、選んでいる曲が見える」形を、11-03 のタブの見た目のまま戻した（2026-11-08。Discord の利用者の声から）。
       上の段: 保存｜自動で次へ｜上限｜ピン（あまり押さないのでアイコンだけ、ピンは小さく）。
       真ん中: 選んでいる曲の行（左端に青い縦線）。行ごと押すと種類の小窓が出る。右端はお試しのランプ（TrialLamp が置く）。
       下の段: 推薦の近道（手札 3 つ。設定で選ぶ。名前 ⌄）。移動中・知らせ・つながらないときは、同じ高さのまま文の 1 マスに替わる。
       曲の詳細には何も重ねない。ほかの MOD で曲の詳細の形が変わると、隠れたり重なったりしたので（2026-11-08）。
       どの文も 1 行に固定し、はみ出す分は … で切る。マスの色は RecommendationTab.cs の PaintTiles -->
  <vertical child-control-height='true' child-expand-height='false' child-align='UpperCenter' spacing='0.6' pad='0'>
    <!-- 上の段: アイコンだけのマス（2026-11-09）。マスは 7.4 x 5 が 3 つ（左寄せ）、地だけの 44.1、ピンの 7.4、隙間なし（幅を足して 73.7。高さ 6 で幅いっぱいに散らすと間延びして見えた。2026-11-10）。
         名前は手を当てたときの説明で出す。切り替え（自動で次へ・上限・ピン）は入でも切でも同じ絵で、入のときだけ青く灯り、下端に点が付く
         （絵を入れ替えると、今の状態か押したときの動きか分かりにくかった）。点の位置は RecommendationTab.cs の PlaceDot（BSML の余白は整数しか書けない）。
         押せる範囲はマス全体（絵の PNG のまわりを空けてある） -->
    <horizontal spacing='0' preferred-width='73.7' preferred-height='5' child-expand-width='false' child-align='MiddleCenter'>
      <!-- 保存: フロッピー。押すとすぐ実行（今の並びをプレイリストに残す）。同じ組み合わせが保存済みなら緑で、押せない -->
      <stack preferred-width='7.4' preferred-height='5' flexible-width='0'>
        <image id='save-plate' src='#RoundRect10'/>
        <clickable-image id='save-icon' src='OctantPath.Icons.save.png' on-click='save-click' preserve-aspect='true' hover-hint='~save-hint'/>
      </stack>
      <!-- ミックスの曲を遊び終えたら、次の曲を自動で選ぶか（settings の mixAutoAdvance）。stack は伸びる幅を 0 にする -->
      <stack preferred-width='7.4' preferred-height='5' flexible-width='0'>
        <image id='auto-next-plate' src='#RoundRect10'/>
        <clickable-image id='auto-next-icon' src='OctantPath.Icons.auto-next.png' on-click='auto-next-click' preserve-aspect='true' hover-hint='~auto-next-hint'/>
        <image id='auto-next-dot' src='OctantPath.Icons.dot.png' preserve-aspect='true'/>
      </stack>
      <!-- 難しさの上限（settings の difficultyCeiling）。絵は山。下見の小窓の下の列でも切り替えられる -->
      <stack preferred-width='7.4' preferred-height='5' flexible-width='0'>
        <image id='ceiling-plate' src='#RoundRect10'/>
        <clickable-image id='ceiling-icon' src='OctantPath.Icons.ceiling.png' on-click='ceiling-click' preserve-aspect='true' hover-hint='~ceiling-hint'/>
        <image id='ceiling-dot' src='OctantPath.Icons.dot.png' preserve-aspect='true'/>
      </stack>
      <!-- 3 つは左に寄せ、ピンは右端。間は押せない地だけのマス（4 つが板の幅いっぱいに散ると間延びして見えた。2026-11-10） -->
      <stack preferred-width='44.1' preferred-height='5' flexible-width='0'>
        <image id='top-gap-plate' src='#RoundRect10'/>
      </stack>
      <!-- 固定と移動の切り替え。移動中だけ灯る -->
      <stack preferred-width='7.4' preferred-height='5' flexible-width='0'>
        <image id='pin-plate' src='#RoundRect10'/>
        <clickable-image id='pin-icon' src='OctantPath.Icons.pin-tile.png' on-click='pin-click' preserve-aspect='true' hover-hint='~pin-hint'/>
        <image id='pin-dot' src='OctantPath.Icons.dot.png' preserve-aspect='true'/>
      </stack>
    </horizontal>
    <!-- 真ん中: 選んでいる曲（曲名、作者 [譜面作者] 難易度の 2 行）とお試しのランプ -->
    <stack id='song-row' preferred-width='73.7' preferred-height='10.2' flexible-width='0'>
      <image id='song-plate' src='#RoundRect10'/>
      <!-- 文は行いっぱいに広げ、右の余白（ランプの分）は RecommendationTab.cs で TMP の margin として空ける。
           横の並び（horizontal）に入れると文の幅が文字の長さで決まり、ランプが行の途中に来た（2026-11-08） -->
      <clickable-text id='song-label' text='~song-text' on-click='song-click' font-size='3' align='Left' word-wrapping='false' overflow-mode='Ellipsis'
                      hover-hint='~song-hint'/>
    </stack>
    <!-- 下の段: 推薦の近道 3 つ（マスは 24.57 x 6、隙間なし。区切りの線も置かない）。名前の右に下向きの山形（押すと下に推薦の板が開く。2026-11-09）。
         山形は RecommendationTab.cs で名前の長さに合わせて置く。押すと、選んでいる曲を起点に、その手札で下見を出す -->
    <horizontal active='~shortcuts-visible' spacing='0' preferred-width='73.7' preferred-height='6' child-expand-width='false' child-align='MiddleCenter'>
      <stack preferred-width='24.57' preferred-height='6' flexible-width='0'>
        <image id='shortcut-0-plate' src='#RoundRect10'/>
        <clickable-text id='shortcut-0-label' text='-' on-click='shortcut-0-click' font-size='2.6' align='Center' word-wrapping='false' overflow-mode='Ellipsis' hover-hint='-'/>
        <image id='shortcut-0-mark' src='OctantPath.Icons.chevron-down.png' preserve-aspect='true'/>
      </stack>
      <stack preferred-width='24.57' preferred-height='6' flexible-width='0'>
        <image id='shortcut-1-plate' src='#RoundRect10'/>
        <clickable-text id='shortcut-1-label' text='-' on-click='shortcut-1-click' font-size='2.6' align='Center' word-wrapping='false' overflow-mode='Ellipsis' hover-hint='-'/>
        <image id='shortcut-1-mark' src='OctantPath.Icons.chevron-down.png' preserve-aspect='true'/>
      </stack>
      <stack preferred-width='24.57' preferred-height='6' flexible-width='0'>
        <image id='shortcut-2-plate' src='#RoundRect10'/>
        <clickable-text id='shortcut-2-label' text='-' on-click='shortcut-2-click' font-size='2.6' align='Center' word-wrapping='false' overflow-mode='Ellipsis' hover-hint='-'/>
        <image id='shortcut-2-mark' src='OctantPath.Icons.chevron-down.png' preserve-aspect='true'/>
      </stack>
    </horizontal>
    <!-- 下の段（近道の代わり）: 移動中は「最初の位置に戻す」、知らせ、つながらないときはその状態。押すと、知らせを消して接続を確かめ直す。
         ペアリングは設定の「OctantCompass との接続」で行う -->
    <stack active='~status-visible' preferred-width='73.7' preferred-height='6' flexible-width='0'>
      <image id='status-plate' src='#RoundRect10'/>
      <clickable-text text='~status-text' on-click='status-click' hover-hint='~status-hint' font-size='2.6' align='Center' word-wrapping='false' overflow-mode='Ellipsis'/>
    </stack>
    <!-- 並びの一覧を出す設定のときだけ: 取得と見せ方、一覧、選んでいる曲の 1 行 -->
    <horizontal active='~list-visible' spacing='1' preferred-width='116' preferred-height='7' child-expand-width='false' child-align='MiddleCenter'>
      <button text='{{panel.get}}' on-click='play-click' interactable='~play-interactable' preferred-width='24' preferred-height='7' hover-hint='{{panel.getHint}}'/>
      <button text='~filter-text' on-click='filter-click' interactable='~mix-interactable' preferred-width='30' preferred-height='7' hover-hint='{{panel.filterHint}}'/>
    </horizontal>
    <list id='list' active='~list-visible' select-cell='select-cell' visible-cells='3' cell-size='7.5' list-style='List' preferred-width='112' preferred-height='24'/>
    <text text='~detail-text' active='~list-visible' font-size='3' align='Center' word-wrapping='false' overflow-mode='Ellipsis' preferred-width='112' preferred-height='5'/>
  </vertical>
</bg>
